{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/intervention-plan.schema.json",
  "title": "CausalPerf Intervention Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "hypothesis_id", "prediction_id", "created_at", "intent", "primary_factor", "allowed_paths", "patch_sha256", "risk", "approval", "rollback", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^IP-[A-Z0-9-]+$"},
    "hypothesis_id": {"type": "string", "pattern": "^H-[A-Z0-9-]+$"},
    "prediction_id": {"type": "string", "pattern": "^PR-[A-Z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "intent": {"type": "string", "minLength": 10},
    "primary_factor": {"type": "string", "minLength": 3},
    "additional_factors": {"type": "array", "items": {"type": "string"}},
    "multi_factor_justification": {"type": "string", "minLength": 10},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {"required": {"type": "boolean"}, "status": {"enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "DENIED"]}, "approval_id": {"type": "string"}}
    },
    "rollback": {"type": "object", "additionalProperties": false, "required": ["strategy", "baseline_source_sha256"], "properties": {"strategy": {"enum": ["reverse_patch", "restore_clean_copy"]}, "baseline_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{"if": {"required": ["additional_factors"], "properties": {"additional_factors": {"minItems": 1}}}, "then": {"required": ["multi_factor_justification"]}}]
}
