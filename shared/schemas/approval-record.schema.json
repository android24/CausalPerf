{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/approval-record.schema.json",
  "title": "CausalPerf Approval Record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "risk", "scope", "request_sha256", "decision", "decided_at", "approver_ref", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^AP-[A-Z0-9-]+$"}, "run_id": {"type": "string", "minLength": 1},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]}, "scope": {"type": "object", "minProperties": 1},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"enum": ["APPROVED", "DENIED", "REVOKED"]}, "decided_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "approver_ref": {"type": "string", "minLength": 1}, "reason": {"type": "string"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
