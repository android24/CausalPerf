{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/schema-bundle.schema.json",
  "title": "CausalPerf Schema Bundle Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "bundle_version", "json_schema_draft",
    "entries", "migration_registry", "bundle_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"const": "causalperf-contracts"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "json_schema_draft": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "schema_id", "document_schema_version", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(shared|causalperf-agent|causalperf-bench)/.+\\.json$"},
          "schema_id": {"type": "string", "format": "uri"},
          "document_schema_version": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "migration_registry": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_id", "from_version", "to_version", "function"],
        "properties": {
          "schema_id": {"type": "string", "format": "uri"},
          "from_version": {"type": "integer", "minimum": 1},
          "to_version": {"type": "integer", "minimum": 2},
          "function": {"type": "string", "minLength": 1},
          "information_loss": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
