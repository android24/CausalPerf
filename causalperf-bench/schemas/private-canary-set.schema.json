{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/bench/schemas/private-canary-set.schema.json",
  "title": "CausalPerf Private Canary Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task_id", "task_version", "generated_at", "canaries", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^CS-[A-Z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "canaries": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {"type": "string", "pattern": "^CANARY-[A-Z0-9-]+$"},
          "value": {"type": "string", "pattern": "^CAUSALPERF_PRIVATE_CANARY_[A-Za-z0-9_-]{16,}$"}
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
