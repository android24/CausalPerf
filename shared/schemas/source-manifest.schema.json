{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/source-manifest.schema.json",
  "title": "CausalPerf Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "run_id", "role", "created_at", "entries",
    "tree_sha256", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^SM-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["BASELINE", "TREATMENT", "RESTORED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applied_patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "TREATMENT"}}},
      "then": {"required": ["applied_patch_sha256"]}
    }
  ]
}
