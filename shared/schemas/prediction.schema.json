{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/prediction.schema.json",
  "title": "CausalPerf Registered Prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "hypothesis_id", "registered_at", "mechanism",
    "primary_metric", "expected_direction", "minimum_effect",
    "expected_mechanism_change", "falsification_conditions", "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^PR-[A-Z0-9-]+$" },
    "hypothesis_id": { "type": "string", "pattern": "^H-[A-Z0-9-]+$" },
    "registered_at": { "type": "string", "format": "date-time" },
    "mechanism": { "type": "string", "minLength": 20 },
    "primary_metric": { "type": "string", "minLength": 1 },
    "expected_direction": { "enum": ["increase", "decrease"] },
    "minimum_effect": {
      "type": "object", "additionalProperties": false,
      "required": ["absolute", "relative_percent", "combination"],
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative_percent": { "type": "number", "minimum": 0 },
        "combination": { "enum": ["both", "either", "maximum"] }
      }
    },
    "expected_mechanism_change": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "direction"],
        "properties": {
          "metric": { "type": "string" },
          "direction": { "enum": ["increase", "decrease", "present", "absent"] }
        }
      }
    },
    "protected_secondary_metrics": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric", "unit", "regression_direction", "maximum_regression_percent"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "regression_direction": {"enum": ["increase", "decrease"]},
          "maximum_regression_percent": {"type": "number", "minimum": 0}
        }
      }
    },
    "falsification_conditions": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
