{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/partition-registry.schema.json",
  "title": "CausalPerf Partition Registry",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_version", "protocol_version", "entries", "created_at", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "task_id": {"type": "string", "minLength": 1}, "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "protocol_version": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_sha256", "partition", "registered_at"], "properties": {"artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "partition": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]}, "registered_at": {"type": "string", "format": "date-time"}, "session_id": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
