{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/experiment-result.schema.json",
  "title": "CausalPerf Experiment Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "task_id", "task_version", "partition", "protocol_version", "started_at", "completed_at", "prediction_id", "intervention_id", "measurement_set_ids", "gate_result_ids", "artifact_ids", "decision", "support_level", "ledger_head_sha256", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^ER-[A-Z0-9-]+$"}, "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1}, "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "partition": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]}, "protocol_version": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "prediction_id": {"type": "string", "pattern": "^PR-[A-Z0-9-]+$"}, "intervention_id": {"type": "string", "pattern": "^IP-[A-Z0-9-]+$"},
    "measurement_set_ids": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"}, "uniqueItems": true},
    "gate_result_ids": {"type": "array", "minItems": 5, "items": {"type": "string"}, "uniqueItems": true}, "artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "uniqueItems": true},
    "decision": {"enum": ["ACCEPT", "REJECT", "INCONCLUSIVE", "INVALID", "ROLLBACK_REQUIRED"]}, "support_level": {"enum": ["NONE", "O1", "E1", "C1", "C2"]},
    "rollback_result_id": {"type": "string", "pattern": "^RR-[A-Z0-9-]+$"}, "ledger_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [{"if": {"properties": {"decision": {"const": "ROLLBACK_REQUIRED"}}}, "then": {"required": ["rollback_result_id"]}}]
}
