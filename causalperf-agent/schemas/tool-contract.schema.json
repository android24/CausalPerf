{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/agent/schemas/tool-contract.schema.json",
  "title": "CausalPerf Agent Tool Contract",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tool_id", "request"],
  "properties": {
    "schema_version": {"const": 1},
    "tool_id": {"enum": ["inspect_source", "query_trace", "inspect_device", "build_variant", "install_apk", "run_benchmark", "apply_patch", "rollback_patch", "publish_patch"]},
    "request": {"type": "object"},
    "response": {"$ref": "#/$defs/response"}
  },
  "oneOf": [
    {"properties": {"tool_id": {"const": "inspect_source"}, "request": {"$ref": "#/$defs/inspectSource"}}},
    {"properties": {"tool_id": {"const": "query_trace"}, "request": {"$ref": "#/$defs/queryTrace"}}},
    {"properties": {"tool_id": {"const": "inspect_device"}, "request": {"$ref": "#/$defs/inspectDevice"}}},
    {"properties": {"tool_id": {"const": "build_variant"}, "request": {"$ref": "#/$defs/command"}}},
    {"properties": {"tool_id": {"const": "install_apk"}, "request": {"$ref": "#/$defs/installApk"}}},
    {"properties": {"tool_id": {"const": "run_benchmark"}, "request": {"$ref": "#/$defs/benchmark"}}},
    {"properties": {"tool_id": {"const": "apply_patch"}, "request": {"$ref": "#/$defs/applyPatch"}}},
    {"properties": {"tool_id": {"const": "rollback_patch"}, "request": {"$ref": "#/$defs/rollbackPatch"}}},
    {"properties": {"tool_id": {"const": "publish_patch"}, "request": {"$ref": "#/$defs/publishPatch"}}}
  ],
  "$defs": {
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inspectSource": {"type": "object", "additionalProperties": false, "required": ["root", "paths", "max_bytes"], "properties": {"root": {"$ref": "#/$defs/relativePath"}, "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}, "uniqueItems": true}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 10000000}}},
    "queryTrace": {"type": "object", "additionalProperties": false, "required": ["trace_artifact_id", "collector_id", "query_id", "parameters", "row_limit", "timeout_seconds"], "properties": {"trace_artifact_id": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "collector_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "parameters": {"type": "object"}, "row_limit": {"type": "integer", "minimum": 1, "maximum": 10000}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}}},
    "inspectDevice": {"type": "object", "additionalProperties": false, "required": ["device_serial_hash", "checks"], "properties": {"device_serial_hash": {"$ref": "#/$defs/sha256"}, "checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["identity", "battery", "thermal", "cpu", "memory", "storage", "background_load", "compilation"]}}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["executable", "args", "working_directory", "environment", "timeout_seconds", "output_limit_bytes"], "properties": {"executable": {"type": "string", "pattern": "^[A-Za-z0-9._/+:-]+$"}, "args": {"type": "array", "items": {"type": "string"}}, "working_directory": {"$ref": "#/$defs/relativePath"}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 14400}, "output_limit_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000}}},
    "installApk": {"type": "object", "additionalProperties": false, "required": ["device_serial_hash", "package_name", "apk_artifact_id", "apk_sha256", "timeout_seconds"], "properties": {"device_serial_hash": {"$ref": "#/$defs/sha256"}, "package_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"}, "apk_artifact_id": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "apk_sha256": {"$ref": "#/$defs/sha256"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}}},
    "benchmark": {"type": "object", "additionalProperties": false, "required": ["command", "device_serial_hash", "package_name", "partition", "sequence_plan_sha256"], "properties": {"command": {"$ref": "#/$defs/command"}, "device_serial_hash": {"$ref": "#/$defs/sha256"}, "package_name": {"type": "string", "minLength": 3}, "partition": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]}, "sequence_plan_sha256": {"$ref": "#/$defs/sha256"}}},
    "applyPatch": {"type": "object", "additionalProperties": false, "required": ["intervention_id", "patch_artifact_id", "patch_sha256", "baseline_source_sha256", "allowed_paths", "approval_id"], "properties": {"intervention_id": {"type": "string", "pattern": "^IP-[A-Z0-9-]+$"}, "patch_artifact_id": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "patch_sha256": {"$ref": "#/$defs/sha256"}, "baseline_source_sha256": {"$ref": "#/$defs/sha256"}, "allowed_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relativePath"}, "uniqueItems": true}, "approval_id": {"type": "string", "pattern": "^AP-[A-Z0-9-]+$"}}},
    "rollbackPatch": {"type": "object", "additionalProperties": false, "required": ["intervention_id", "strategy", "expected_source_sha256", "approval_id"], "properties": {"intervention_id": {"type": "string", "pattern": "^IP-[A-Z0-9-]+$"}, "strategy": {"enum": ["reverse_patch", "restore_clean_copy"]}, "expected_source_sha256": {"$ref": "#/$defs/sha256"}, "approval_id": {"type": "string", "pattern": "^AP-[A-Z0-9-]+$"}}},
    "publishPatch": {"type": "object", "additionalProperties": false, "required": ["experiment_result_id", "patch_artifact_id", "destination", "approval_id"], "properties": {"experiment_result_id": {"type": "string", "pattern": "^ER-[A-Z0-9-]+$"}, "patch_artifact_id": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "destination": {"type": "string", "minLength": 1}, "approval_id": {"type": "string", "pattern": "^AP-[A-Z0-9-]+$"}}},
    "response": {"type": "object", "additionalProperties": false, "required": ["status", "reason_codes", "artifact_ids"], "properties": {"status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "artifact_ids": {"type": "array", "items": {"type": "string", "pattern": "^AR-[A-Z0-9-]+$"}, "uniqueItems": true}}}
  }
}
