{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/integrity-input.schema.json",
  "title": "CausalPerf Integrity Verification Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "run_id", "created_at", "policy_sha256",
    "protected_paths", "source_manifests", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^II-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "source_manifests": {
      "type": "array",
      "items": {"$ref": "source-manifest.schema.json"}
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
