{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/agent/schemas/runtime-policy.schema.json",
  "title": "CausalPerf Agent Runtime Policy",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "network", "readable_paths", "writable_paths", "protected_paths", "allowed_executables", "allowed_working_directories", "allowed_environment_keys", "device_serial_hash", "package_name", "allowed_partitions", "task_approved_risks", "allow_external_publication", "budgets", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "network": {"const": "denied"},
    "readable_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "writable_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "protected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "allowed_executables": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
    "allowed_working_directories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "allowed_environment_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "device_serial_hash": {"$ref": "#/$defs/sha"},
    "package_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"},
    "allowed_partitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]}},
    "task_approved_risks": {"type": "array", "uniqueItems": true, "items": {"enum": ["R0", "R1"]}},
    "allow_external_publication": {"const": false},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_calls", "wall_time_seconds", "experiments", "patch_files", "patch_lines", "output_bytes"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "experiments": {"type": "integer", "minimum": 1},
        "patch_files": {"type": "integer", "minimum": 1},
        "patch_lines": {"type": "integer", "minimum": 1},
        "output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
