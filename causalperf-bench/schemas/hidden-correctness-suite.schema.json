{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/bench/schemas/hidden-correctness-suite.schema.json",
  "title": "CausalPerf Evaluator-only Hidden Correctness Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "task_id", "task_version", "suite_id", "files",
    "command", "forbidden_main_source_tokens", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^HCS-[A-Z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "suite_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "destination", "sha256"],
        "properties": {
          "source": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "destination": {"type": "string", "pattern": "^app/src/androidTest/.+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "args", "working_directory", "timeout_seconds"],
      "properties": {
        "executable": {"const": "gradle-wrapper"},
        "args": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "working_directory": {"const": "."},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "forbidden_main_source_tokens": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
