{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/bench/schemas/isolation-report.schema.json",
  "title": "CausalPerf Evaluation Isolation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "task_id", "started_at", "completed_at", "backend", "status", "controls", "scans", "reason_codes", "artifact_digests", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^IR-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "backend": {"enum": ["DARWIN_SANDBOX", "LINUX_BWRAP", "UNAVAILABLE"]},
    "status": {"enum": ["PASS", "AGENT_FAILED", "EVALUATOR_FAILED", "LEAK_DETECTED", "UNSUPPORTED"]},
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["network_denied", "separate_views", "environment_allowlisted", "owned_process_group"],
      "properties": {
        "network_denied": {"type": "boolean"},
        "separate_views": {"type": "boolean"},
        "environment_allowlisted": {"type": "boolean"},
        "owned_process_group": {"type": "boolean"}
      }
    },
    "agent_exit_code": {"type": "integer"},
    "evaluator_exit_code": {"type": "integer"},
    "scans": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "status", "finding_codes", "files_scanned", "bytes_scanned"],
        "properties": {
          "phase": {"enum": ["PRE_INPUT", "PRE_ENVIRONMENT", "POST_WORKSPACE", "POST_OUTPUT", "POST_LOG", "POST_EVALUATOR"]},
          "status": {"enum": ["PASS", "FAIL"]},
          "finding_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["PRIVATE_CANARY", "PRIVATE_MARKER", "FORBIDDEN_PATH", "SYMLINK", "SCAN_LIMIT_EXCEEDED"]}},
          "files_scanned": {"type": "integer", "minimum": 0},
          "bytes_scanned": {"type": "integer", "minimum": 0}
        }
      }
    },
    "reason_codes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["ISOLATION_BACKEND_UNAVAILABLE", "ISOLATION_BACKEND_PROBE_FAILED", "AGENT_PROCESS_FAILED", "AGENT_PROCESS_TIMEOUT", "EVALUATOR_PROCESS_FAILED", "EVALUATOR_PROCESS_TIMEOUT", "LEAKAGE_SCAN_FAILED", "PROTECTED_PATH_CHANGED", "ENVIRONMENT_KEY_NOT_ALLOWED", "LAYOUT_NOT_SEPARATED", "OUTPUT_LIMIT_EXCEEDED"]}
    },
    "artifact_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
