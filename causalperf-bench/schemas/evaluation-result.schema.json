{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/evaluation-result.schema.json",
  "title": "CausalPerf Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "task_version", "run_id", "verdict",
    "gates", "scores", "artifact_digests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string" },
    "task_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["ACCEPT", "REJECT", "INCONCLUSIVE", "INVALID"] },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "correctness", "environment", "mechanism", "performance"],
      "properties": {
        "integrity": { "$ref": "#/$defs/gate" },
        "correctness": { "$ref": "#/$defs/gate" },
        "environment": { "$ref": "#/$defs/gate" },
        "mechanism": { "$ref": "#/$defs/gate" },
        "performance": { "$ref": "#/$defs/gate" }
      }
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["diagnosis", "evidence", "patch", "reproducibility", "overall"],
      "properties": {
        "diagnosis": { "$ref": "#/$defs/score" },
        "evidence": { "$ref": "#/$defs/score" },
        "patch": { "$ref": "#/$defs/score" },
        "reproducibility": { "$ref": "#/$defs/score" },
        "overall": { "$ref": "#/$defs/score" }
      }
    },
    "artifact_digests": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "reason_codes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
