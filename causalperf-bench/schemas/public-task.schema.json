{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/public-task.schema.json",
  "title": "CausalPerf Public Performance Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "category", "platform", "target",
    "source", "commands", "measurement", "agent_access", "budgets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "category": { "enum": ["startup"] },
    "description": { "type": "string", "maxLength": 4000 },
    "platform": { "$ref": "#/$defs/platform" },
    "target": { "$ref": "#/$defs/target" },
    "source": { "$ref": "#/$defs/source" },
    "commands": { "$ref": "#/$defs/commands" },
    "measurement": { "$ref": "#/$defs/measurement" },
    "agent_access": { "$ref": "#/$defs/agentAccess" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "public_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_api", "max_api", "device_class"],
      "properties": {
        "min_api": { "type": "integer", "minimum": 29 },
        "max_api": { "type": "integer", "minimum": 29 },
        "device_class": { "enum": ["physical", "emulator", "either"] },
        "abis": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["arm64-v8a", "x86_64"] }
        },
        "required_features": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "startup_mode", "practical_threshold"],
      "properties": {
        "primary_metric": { "enum": ["timeToInitialDisplayMs", "timeToFullDisplayMs"] },
        "startup_mode": { "enum": ["COLD", "WARM", "HOT"] },
        "practical_threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_percent", "absolute_ms", "combination"],
          "properties": {
            "relative_percent": { "type": "number", "exclusiveMinimum": 0 },
            "absolute_ms": { "type": "number", "exclusiveMinimum": 0 },
            "combination": { "enum": ["both", "either", "maximum"] }
          }
        },
        "protected_secondary_metrics": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "max_regression_percent"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "max_regression_percent": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "application_id", "build_variant"],
      "properties": {
        "revision": { "type": "string", "minLength": 7 },
        "application_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "build_variant": { "type": "string", "minLength": 1 },
        "launch_component": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "working_directory", "timeout_seconds"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 14400 },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "correctness", "performance"],
      "properties": {
        "build": { "$ref": "#/$defs/command" },
        "correctness": { "$ref": "#/$defs/command" },
        "performance": { "$ref": "#/$defs/command" },
        "cleanup": { "$ref": "#/$defs/command" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design", "stabilization_iterations", "measurement_iterations_per_arm",
        "compilation_mode", "bootstrap_resamples", "confidence_level",
        "max_invalid_sample_percent"
      ],
      "properties": {
        "design": { "const": "a1_b_a2" },
        "random_seed": { "type": "integer", "minimum": 0 },
        "stabilization_iterations": { "type": "integer", "minimum": 0, "maximum": 20 },
        "measurement_iterations_per_arm": { "type": "integer", "minimum": 10, "maximum": 500 },
        "compilation_mode": { "enum": ["none", "partial", "full", "speed-profile"] },
        "bootstrap_resamples": { "type": "integer", "minimum": 1000, "maximum": 1000000 },
        "confidence_level": { "type": "number", "exclusiveMinimum": 0.8, "exclusiveMaximum": 1 },
        "max_invalid_sample_percent": { "type": "number", "minimum": 0, "maximum": 25 },
        "max_baseline_drift_percent": { "type": "number", "minimum": 0, "maximum": 50 }
      },
      "allOf": [
        {
          "if": { "properties": { "design": { "const": "randomized_interleaved" } } },
          "then": { "required": ["random_seed"] }
        },
        {
          "if": { "properties": { "design": { "const": "a1_b_a2" } } },
          "then": { "required": ["max_baseline_drift_percent"] }
        }
      ]
    },
    "agentAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writable_paths", "protected_paths", "network"],
      "properties": {
        "writable_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "protected_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "network": { "enum": ["denied", "allowlisted"] },
        "allowed_hosts": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds", "max_experiments", "max_patch_files"],
      "properties": {
        "wall_time_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
        "max_experiments": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_patch_files": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_patch_lines": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
