{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/task-reproduction-package.schema.json",
  "title": "CausalPerf Task Reproduction Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_version", "protocol_version", "lifecycle", "artifacts", "partitions"],
  "properties": {
    "schema_version": {"const": 2},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["DRAFT", "IMPLEMENTED", "CALIBRATED", "QUALIFIED", "FROZEN"]},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "partition", "visibility", "status"],
        "properties": {
          "kind": {"enum": ["TASK_SPEC", "SOURCE", "PUBLIC_TASK", "CORRECTNESS_TESTS", "BENCHMARK_SCENARIO", "GROUND_TRUTH", "REFERENCE_PATCH", "ENVIRONMENT_SNAPSHOT", "A1_B_A2_MEASUREMENTS", "TRACES", "MECHANISM_EVIDENCE", "VARIANCE_REPORT", "INDEPENDENT_REPLAY", "LEAKAGE_REVIEW"]},
          "partition": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]},
          "visibility": {"enum": ["PUBLIC", "PRIVATE"]},
          "status": {"enum": ["MISSING", "PRESENT", "VERIFIED"]},
          "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["PRESENT", "VERIFIED"]}}}, "then": {"required": ["relative_path", "sha256"]}},
          {"if": {"properties": {"status": {"const": "MISSING"}}}, "then": {"required": ["reason"]}}
        ]
      }
    },
    "partitions": {
      "type": "object", "additionalProperties": false,
      "required": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"],
      "properties": {
        "DEVELOPMENT": {"$ref": "#/$defs/partition"},
        "CALIBRATION": {"$ref": "#/$defs/partition"},
        "QUALIFICATION": {"$ref": "#/$defs/partition"},
        "EVALUATION": {"$ref": "#/$defs/partition"}
      }
    }
  },
  "$defs": {
    "partition": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "session_ids", "artifact_sha256s"],
      "properties": {
        "status": {"enum": ["NOT_STARTED", "OPEN", "SEALED"]},
        "session_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "artifact_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true}
      }
    }
  }
}
