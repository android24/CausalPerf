{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/schemas/measurement-set.schema.json",
  "title": "CausalPerf Measurement Set",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "partition", "arm", "metric", "unit", "measurements", "policy", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^MS-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "partition": {"enum": ["DEVELOPMENT", "CALIBRATION", "QUALIFICATION", "EVALUATION"]},
    "arm": {"enum": ["A1", "B", "A2", "REPLICATION"]},
    "metric": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "measurements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sequence", "value", "measured_at", "environment_snapshot_id", "source_sha256", "apk_sha256", "included"],
        "properties": {
          "id": {"type": "string", "pattern": "^M-[A-Z0-9-]+$"},
          "sequence": {"type": "integer", "minimum": 0},
          "value": {"type": "number", "minimum": 0},
          "measured_at": {"type": "string", "format": "date-time"},
          "environment_snapshot_id": {"type": "string", "pattern": "^ENV-[A-Z0-9-]+$"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "apk_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "trace_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "included": {"type": "boolean"},
          "exclusion_reason": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"properties": {"included": {"const": false}}}, "then": {"required": ["exclusion_reason"]}}]
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["warmup_count", "minimum_included", "max_invalid_percent", "predeclared_exclusion_codes"],
      "properties": {
        "warmup_count": {"type": "integer", "minimum": 0},
        "minimum_included": {"type": "integer", "minimum": 1},
        "max_invalid_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "predeclared_exclusion_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
