{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causalperf.dev/bench/schemas/isolation-run.schema.json",
  "title": "CausalPerf Isolated Evaluation Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "task_id", "task_version", "policy_sha256", "canary_set_sha256", "public_source", "private_evaluator", "run_root", "agent_command", "evaluator_command", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^ISR-[A-Z0-9-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "task_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_sha256": {"$ref": "#/$defs/sha"},
    "canary_set_sha256": {"$ref": "#/$defs/sha"},
    "public_source": {"$ref": "#/$defs/absolutePath"},
    "private_evaluator": {"$ref": "#/$defs/absolutePath"},
    "run_root": {"$ref": "#/$defs/absolutePath"},
    "agent_command": {"$ref": "#/$defs/command"},
    "evaluator_command": {"$ref": "#/$defs/command"},
    "content_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "args", "working_directory", "environment"],
      "properties": {
        "executable": {"$ref": "#/$defs/absolutePath"},
        "args": {"type": "array", "items": {"type": "string"}},
        "working_directory": {"$ref": "#/$defs/absolutePath"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
